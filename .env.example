# Run pnpm setup to generate private local values. Never use these placeholders.
LIGHTSHOW_HOST=lightshow.home.arpa
PUBLIC_ORIGIN=https://lightshow.home.arpa
HTTPS_PORT=443
HTTP_PORT=80
API_PORT=3000
API_HOST=api
LOG_LEVEL=info
ADMIN_PASSWORD_HASH=GENERATE_WITH_SETUP
SESSION_HOURS=24
MONGO_ROOT_USER=lightshow
MONGO_ROOT_PASSWORD=GENERATE_WITH_SETUP
MONGO_API_PASSWORD=GENERATE_WITH_SETUP
MONGO_ENGINE_PASSWORD=GENERATE_WITH_SETUP
MONGO_URL=mongodb://lightshow-api:GENERATE_WITH_SETUP@mongo:27017/lightshow?authSource=lightshow&replicaSet=rs0
MONGO_ENGINE_URL=mongodb://lightshow-engine:GENERATE_WITH_SETUP@mongo:27017/lightshow?authSource=lightshow&replicaSet=rs0
MQTT_URL=mqtts://mosquitto:8883
MQTT_PUBLIC_URL=mqtts://lightshow.home.arpa:8883
MQTT_API_USER=api
MQTT_API_PASSWORD=GENERATE_WITH_SETUP
MQTT_ENGINE_USER=engine
MQTT_ENGINE_PASSWORD=GENERATE_WITH_SETUP
MQTT_CA_FILE=/run/trust/mqtt-ca.crt
HTTPS_CA_FILE=/run/trust/https-ca.crt
CADDY_TLS=internal
TARGET_FPS=40
DDP_PORT=4048
# Optional simulator (docker compose --profile simulator up -d)
SIM_HARDWARE_ID=sim-yard-1
SIM_STATE_FILE=/state/identity.json
SIM_API_URL=https://lightshow.home.arpa
SIM_INSPECT_PORT=4090
# Generate a hardware-bound one-use enrollment credential in the UI; place here locally.
SIM_PROVISIONING_TOKEN=
