{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true, "types": ["node"]
  },
  "include": ["apps/*/src/**/*.ts", "packages/**/*.ts", "tests/**/*.ts"],
  "exclude": ["apps/ui", "node_modules", "**/dist"]
}
