{
	"name": "lightshow",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.20.0",
	"engines": {
		"node": ">=24 <25"
	},
	"scripts": {
		"build": "pnpm typecheck && pnpm --filter @lightshow/ui build",
		"typecheck": "tsc --noEmit && pnpm --filter @lightshow/ui typecheck && tsc --noEmit -p tests/browser/tsconfig.json",
		"test": "node --import tsx --test tests/*.test.ts",
		"test:integration": "node --import tsx --test tests/integration/*.test.ts",
		"setup": "node scripts/setup.mjs",
		"trust": "node scripts/export-trust.mjs",
		"docker:start": "docker compose up -d --build",
		"docker:down": "docker compose down",
		"docker:restart": "docker compose restart",
		"dev:api": "tsx watch apps/api/src/main.ts",
		"dev:engine": "tsx watch apps/show-engine/src/main.ts",
		"dev:ui": "pnpm --filter @lightshow/ui dev",
		"simulator": "tsx apps/esp-simulator/src/main.ts",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:firmware": "node scripts/test-firmware.mjs",
		"test:browser": "node scripts/browser-test.mjs",
		"demo": "node scripts/demo.mjs"
	},
	"dependencies": {
		"@fastify/cookie": "11.1.3",
		"@fastify/rate-limit": "10.3.0",
		"@fastify/swagger": "9.9.2",
		"@fastify/swagger-ui": "6.1.2",
		"@sinclair/typebox": "0.34.41",
		"argon2": "0.44.0",
		"dotenv": "17.2.3",
		"fastify": "5.12.7",
		"mongodb": "6.20.0",
		"mqtt": "5.14.1",
		"undici": "7.30.1"
	},
	"devDependencies": {
		"@playwright/test": "1.56.1",
		"@types/node": "24.10.0",
		"prettier": "3.6.2",
		"tsx": "4.20.6",
		"typescript": "5.9.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"argon2",
			"esbuild"
		]
	}
}
