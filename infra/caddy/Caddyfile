{$LIGHTSHOW_HOST:lightshow.home.arpa} {
	tls {$CADDY_TLS:internal}
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
	}
	handle /v1/* {
		reverse_proxy {$API_UPSTREAM:api:3000} {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy ui:80
	}
}
